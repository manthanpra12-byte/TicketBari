# Copy this file to .env (never commit .env). Docker Compose reads it automatically.
# After editing .env, apply it with:  docker compose up -d gateway catalog worker
# Every line below shows the DEFAULT. Delete .env to go back to defaults.

# Rate limiter (token bucket) at the gateway
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL=10

# Catalog cache. Set to false to measure the system without the cache.


# Print one log line per request. Set to false during load tests (thousands of lines slow Docker down).
LOG_REQUESTS=true

# Chance (0 to 1) that one fake payment attempt fails
PAYMENT_FAIL_RATE=0.3

RATE_LIMIT_CAPACITY=100000
RATE_LIMIT_REFILL=100000
LOG_REQUESTS=false
